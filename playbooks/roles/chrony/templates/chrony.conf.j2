# {{ ansible_managed }}
{% if inventory_hostname in groups[chrony_server_group] %}
# Lab time server: syncs upstream over NAT, serves the management network.
{% for p in chrony_upstream_pools %}
pool {{ p }} iburst maxsources 2
{% endfor %}
allow {{ chrony_allow_network }}
# Keep serving the lab if the internet is gone, so nodes stay in step.
local stratum 10
{% else %}
# Lab node: single time source so all nodes agree (Ceph mon skew < 0.05s).
server {{ chrony_server }} iburst prefer
{% endif %}

keyfile /etc/chrony/chrony.keys
driftfile /var/lib/chrony/chrony.drift
ntsdumpdir /var/lib/chrony
logdir /var/log/chrony
maxupdateskew 100.0
rtcsync
makestep 1 3
leapsectz right/UTC
